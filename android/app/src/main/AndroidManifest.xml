<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="cn.wps.moffice_eng" />
        <package android:name="cn.wps.moffice_i18n" />
        <package android:name="cn.wps.moffice" />
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/*" /></intent>
        <intent><action android:name="android.intent.action.EDIT" /><data android:mimeType="application/*" /></intent>
    </queries>
    <application
        android:name=".LanCmdApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LanCmd">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LanCmdService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity android:name=".MediaActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".DesktopActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ControlActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.officefiles" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/office_file_paths" />
        </provider>
        <activity android:name=".OfficeDocumentActivity" android:exported="false" />
        <activity android:name=".FileSearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".StorageActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PlaceholderFilesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DevicesActivity" android:exported="false" />
        <activity android:name=".AppsActivity" android:exported="false" />
        <activity android:name=".CommandsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RecordingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GesturesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".TextEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".FileLocksActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AppLocksActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ApplicationsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".WallpaperActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".UpgradeActivity" android:exported="false" />
        <activity android:name=".StartupNetworkActivity" android:exported="false" />
        <activity android:name=".NetworkManagementActivity" android:exported="false" />
        <activity android:name=".TaskManagerActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RegistryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ShareWebActivity" android:label="发送网页到电脑 · LanCmd" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".PrivacyDevicesActivity" android:exported="false" />
    </application>
</manifest>
