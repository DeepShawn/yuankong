<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LanCmd" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 默认：深海背景 + 薄荷主题色 -->
        <item name="lcBg">#080C12</item>
        <item name="lcSurface">#101722</item>
        <item name="lcSurfaceVariant">#172131</item>
        <item name="lcSurfaceHigh">#1E2A3D</item>
        <item name="lcOutline">#24324A</item>
        <item name="lcOutlineSoft">#1A2537</item>
        <item name="lcText">#EAF1F8</item>
        <item name="lcDim">#8B9AB0</item>
        <item name="lcConsole">#0C121B</item>
        <item name="lcOverlay">#F0080C12</item>
        <item name="lcAccent">#3EE0B5</item>
        <item name="lcAccentDim">#123F37</item>
        <item name="lcAccentGlow">#333EE0B5</item>
        <item name="lcAccent2">#5AA9FF</item>
        <item name="lcAccentEnd">#2CC6C9</item>
        <item name="lcOnAccent">#022B21</item>
        <item name="lcHeroStart">#1A5A4C</item>
        <item name="lcHeroCenter">#14403F</item>
        <item name="lcHeroEnd">#172C4A</item>
        <item name="lcHeroStroke">#3352E3BE</item>
        <item name="lcHeroSub">#B8D4CF</item>
        <item name="colorPrimary">?attr/lcAccent</item>
        <item name="colorOnPrimary">?attr/lcOnAccent</item>
        <item name="colorPrimaryContainer">?attr/lcAccentDim</item>
        <item name="colorOnPrimaryContainer">?attr/lcText</item>
        <item name="colorSecondary">?attr/lcAccent2</item>
        <item name="colorOnSecondary">?attr/lcBg</item>
        <item name="colorSecondaryContainer">?attr/lcAccentDim</item>
        <item name="colorOnSecondaryContainer">?attr/lcAccent</item>
        <item name="colorSurface">?attr/lcSurface</item>
        <item name="colorOnSurface">?attr/lcText</item>
        <item name="colorSurfaceVariant">?attr/lcSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">?attr/lcDim</item>
        <item name="colorSurfaceContainer">?attr/lcSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/lcSurfaceVariant</item>
        <item name="colorSurfaceContainerHighest">?attr/lcSurfaceHigh</item>
        <item name="colorOutline">?attr/lcOutline</item>
        <item name="colorOutlineVariant">?attr/lcOutlineSoft</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">?attr/lcBg</item>
        <item name="android:statusBarColor">?attr/lcBg</item>
        <item name="android:navigationBarColor">?attr/lcBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">?attr/lcText</item>
        <item name="android:textColorSecondary">?attr/lcDim</item>
        <item name="android:textColorHighlight">?attr/lcAccentDim</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LanCmd.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LanCmd.Medium</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LanCmd.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.LanCmd.AlertDialog</item>
    </style>

    <style name="ShapeAppearance.LanCmd.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.LanCmd.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.LanCmd.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ThemeOverlay.LanCmd.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/lcSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/lcSurface</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LanCmd.Dialog</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="ThemeOverlay.LanCmd.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorSurface">?attr/lcSurface</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LanCmd.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LanCmd.DialogButton.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.LanCmd.DialogButton.Muted</item>
    </style>

    <style name="Widget.LanCmd.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/lcAccent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LanCmd.DialogButton.Muted">
        <item name="android:textColor">?attr/lcDim</item>
    </style>

    <style name="Widget.LanCmd.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/lcText</item>
        <item name="backgroundTint">?attr/lcSurface</item>
        <item name="strokeColor">?attr/lcOutline</item>
        <item name="rippleColor">?attr/lcAccentGlow</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.LanCmd.Button.Tonal" parent="Widget.LanCmd.Button.Outlined">
        <item name="backgroundTint">?attr/lcSurfaceVariant</item>
        <item name="strokeColor">?attr/lcOutlineSoft</item>
        <item name="iconTint">?attr/lcAccent</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
    </style>

    <style name="TextAppearance.LanCmd.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/lcText</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LanCmd.SectionLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/lcDim</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LanCmd.ActionLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/lcText</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LanCmd.IconButton" parent="">
        <item name="android:background">@drawable/icon_button_bg</item>
        <item name="android:padding">11dp</item>
        <item name="android:tint">?attr/lcText</item>
    </style>
</resources>
