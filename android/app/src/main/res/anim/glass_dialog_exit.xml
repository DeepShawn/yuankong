<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="160"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
    <scale android:fromXScale="1" android:toXScale="0.96"
        android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="55%" android:duration="160"
        android:interpolator="@android:interpolator/accelerate_cubic" />
</set>
