<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/lcAccentGlow">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="?attr/lcSurfaceHigh"
                android:endColor="?attr/lcSurfaceVariant" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="?attr/lcOutlineSoft" />
        </shape>
    </item>
</ripple>
