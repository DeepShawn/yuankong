#include <winver.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,2,0,0
PRODUCTVERSION  3,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "LanCmd"
            VALUE "FileDescription",  "LanCmd 局域网命令接收端"
            VALUE "FileVersion",      "3.2.0.0"
            VALUE "InternalName",     "LanCmdAgent"
            VALUE "LegalCopyright",   "LanCmd"
            VALUE "OriginalFilename", "LanCmdAgent.exe"
            VALUE "ProductName",      "LanCmd"
            VALUE "ProductVersion",   "3.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
